# Copy to .env.local and fill in.

# Shared secret for build workers. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLOP_WORKER_TOKEN=

# Where the SQLite database and files live (defaults to ./.data).
# SLOP_DATA_DIR=

# Engine version the worker farm builds for (shown on downloads).
# SLOP_TARGET_ENGINE=5.8

# Override the MediaPipe face landmarker model URL (e.g. to self-host it).
# NEXT_PUBLIC_FACE_MODEL_URL=
